# ============================================================
# RestoSaaS production environment configuration
# Copy to .env and fill in REAL values. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 48
# ============================================================

# Database Credentials (REQUIRED - no defaults)
POSTGRES_DB=restaurant_saas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_DB_PASSWORD__

# JWT Security (REQUIRED - min 32 chars; deployment fails without it)
APP_JWT_SECRET=__GENERATE_WITH_openssl_rand_base64_48__
APP_JWT_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=86400000

# Server Environment
NODE_ENV=production
SPRING_PROFILES_ACTIVE=prod
NEXT_PUBLIC_API_URL=/api/v1
