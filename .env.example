# ==============================================================================
# RestoSaaS / Sapru Platform - Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=restaurant_saas_db
POSTGRES_USER=postgres
# In production, replace with a strong, generated password (e.g., openssl rand -hex 16)
POSTGRES_PASSWORD=replace_with_secure_production_password_here

# JWT Security Configuration
# Must be at least 256 bits (64 hex characters). Generate using: openssl rand -hex 32
APP_JWT_SECRET=replace_with_64_character_hex_jwt_secret_for_production_env_here
APP_JWT_EXPIRATION_MS=86400000

# Payment & Billing Webhook Security (Razorpay / Stripe)
BILLING_WEBHOOK_SECRET=replace_with_webhook_signing_secret_from_provider

# Runtime Environments
NODE_ENV=production
SPRING_PROFILES_ACTIVE=prod
NEXT_PUBLIC_API_URL=/api/v1
